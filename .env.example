# Copy to .env (git-ignored). Contains configuration knobs only — NO secrets belong here.

# Dummy key handed to the local Mellum2 workers. Any non-empty string; carries no privilege.
MELLUM_DUMMY_KEY=local-dummy

# Claude CLI launcher. Default invokes the public `claude` binary directly.
# Override only for wrapped/proxied auth setups, e.g. a tool that runs Claude via
#   <tool> run claude-code -- <flags>
# in which case set:
#   CLAUDE_CMD=<tool>
#   CLAUDE_PREFIX_ARGS=run claude-code --
CLAUDE_CMD=claude
CLAUDE_PREFIX_ARGS=

# Optional: per-call timeout for the benchmark (ms).
# BENCH_TIMEOUT_MS=240000
